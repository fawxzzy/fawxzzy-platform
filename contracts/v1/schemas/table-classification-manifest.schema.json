{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fawxzzy:platform:schemas:v1:table-classification-manifest",
  "title": "Provider-neutral table classification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "classification_vocabulary",
    "inventory",
    "entries",
    "omission_gate",
    "lifecycle"
  ],
  "properties": {
    "version": {
      "$ref": "urn:fawxzzy:platform:schemas:v1:common#/$defs/version"
    },
    "status": {
      "const": "CURRENT"
    },
    "classification_vocabulary": {
      "type": "array",
      "prefixItems": [
        {
          "const": "KEEP"
        },
        {
          "const": "TRANSFORM"
        },
        {
          "const": "DERIVE"
        },
        {
          "const": "ARCHIVE"
        },
        {
          "const": "OMIT"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_aggregate_inventory",
        "entries_are_static_source_categories",
        "final_relation_dispositions_admitted"
      ],
      "properties": {
        "live_aggregate_inventory": {
          "const": "UNKNOWN"
        },
        "entries_are_static_source_categories": {
          "const": true
        },
        "final_relation_dispositions_admitted": {
          "const": false
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "omission_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "live_inventory_required",
        "rehearsal_required",
        "retention_proof_required",
        "rollback_proof_required",
        "separate_action_time_deletion_authority_required",
        "source_deletion_admitted"
      ],
      "properties": {
        "status": {
          "const": "BLOCKED"
        },
        "live_inventory_required": {
          "const": true
        },
        "rehearsal_required": {
          "const": true
        },
        "retention_proof_required": {
          "const": true
        },
        "rollback_proof_required": {
          "const": true
        },
        "separate_action_time_deletion_authority_required": {
          "const": true
        },
        "source_deletion_admitted": {
          "const": false
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "apply_admitted"
      ],
      "properties": {
        "execution": {
          "const": "EXECUTION_BLOCKED"
        },
        "apply_admitted": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_domain",
        "source_category",
        "classification",
        "target_domain",
        "requirements",
        "candidate_only",
        "destructive_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "source_domain": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "source_category": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "classification": {
          "enum": [
            "KEEP",
            "TRANSFORM",
            "DERIVE",
            "ARCHIVE",
            "OMIT"
          ]
        },
        "target_domain": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        },
        "candidate_only": {
          "type": "boolean"
        },
        "destructive_action": {
          "const": false
        }
      }
    }
  }
}
