              "accepted_path",
              "source_commit",
              "blob",
              "raw_sha256",
              "byte_count",
              "effect_classes"
            ],
            "properties": {
              "app": {
                "enum": [
                  "discordos",
                  "mazer"
                ]
              },
              "ledger_version": {
                "type": "string",
                "pattern": "^[0-9]{14}$"
              },
              "ledger_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "accepted_path": {
                "type": "string",
                "pattern": "^supabase/migrations/[0-9]{14}_[a-z0-9_]+\\.sql$"
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 0
              },
              "effect_classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "relations",
                    "functions",
                    "policies",
                    "triggers",
                    "indexes",
                    "extensions",
                    "scheduler",
                    "held_functions",
                    "held_data_effects",
                    "held_dynamic_effects",
                    "acls",
                    "provider_ledger",
                    "terminal_catalog"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
