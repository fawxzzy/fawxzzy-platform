  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestampOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executionTrustAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "algorithm",
        "key_id",
        "verifier_reference",
        "public_key_spki_base64",
        "public_key_spki_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "BLOCKED"
          ]
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_reference": {
          "type": "string",
          "minLength": 1
        },
        "public_key_spki_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "public_key_spki_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "executionAuthenticationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "public_key_spki_sha256",
        "signed_payload_sha256",
        "signature_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "public_key_spki_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "signed_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_base64": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "disposition"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aggregateSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "disposition",
        "status",
        "count",
        "aggregate_sha256"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1
